# Telegram
BOT_TOKEN=
ADMIN_IDS=

# Database
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# av.by
AVBY_BASE_URL=https://api.av.by
AVBY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

# Kufar
KUFAR_BASE_URL=https://api.kufar.by

# Worker
CHECK_INTERVAL_SECONDS=600
MAX_NOTIFICATIONS_PER_RUN=20

# App
ENV=dev
LOG_LEVEL=INFO
PORT=10000
WORKER_ENABLED=0

# AI parser (OpenAI-совместимый API, для РБ — aiai.by)
AI_ENABLED=0
AI_BASE_URL=https://api.aiai.by/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
